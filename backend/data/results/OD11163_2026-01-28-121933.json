    },
    {
      "start": 764.63,
      "end": 767.05,
      "speaker": "student",
      "text": "ल्किण मेंगना कोछ भूँस्टी आख है",
      "is_question": false
    },
    {
      "start": 767.05,
      "end": 768.45,
      "speaker": "student",
      "text": "मोब लग",
      "is_question": false
    },
    {
      "start": 768.45,
      "end": 772.98,
      "speaker": "teacher",
      "text": "तबज पलैन पनाला पड़िएगा",
      "is_question": false
    },
    {
      "start": 772.98,
      "end": 781.95,
      "speaker": "teacher",
      "text": "भग उते लिए हैं है, हम उस दाव में पानिगोड़,",
      "is_question": false
    },
    {
      "start": 781.95,
      "end": 784.89,
      "speaker": "teacher",
      "text": "लेकि नहीं हम को तेरना नी आता है.",
      "is_question": false
    },
    {
      "start": 784.89,
      "end": 794.9,
      "speaker": "teacher",
      "text": "हम मों चोटे होगे है अख़े नगी प्र याप ये आचाँ पेर निखाए ने तैख्षे दो ना जागते हें.",
      "is_question": false
    },
    {
      "start": 794.9,
      "end": 798.04,
      "speaker": "teacher",
      "text": "न वाने वो दूस भी भिमार पडया ही न है।",
      "is_question": false
    },
    {
      "start": 798.04,
      "end": 800.04,
      "speaker": "student",
      "text": "तो तब यह ज़ना भी है ना",
      "is_question": false
    },
    {
      "start": 800.04,
      "end": 803.84,
      "speaker": "teacher",
      "text": "अगर अक अस दोस भिमार पड़गे तु विमो थभी अ चम भग़ जाते है",
      "is_question": false
    },
    {
      "start": 803.84,
      "end": 805.12,
      "speaker": "student",
      "text": "अंको प्चटा चला",
      "is_question": false
    },
    {
      "start": 805.12,
      "end": 806.76,
      "speaker": "student",
      "text": "अमकोबचना में हैं नहां",
      "is_question": false
    },
    {
      "start": 806.76,
      "end": 812.58,
      "speaker": "teacher",
      "text": "ती च़ो अ मुन रोना, दूना",
      "is_question": false
    },
    {
      "start": 812.58,
      "end": 814.74,
      "speaker": "student",
      "text": "बन करो आपी हम पैटे हें",
      "is_question": false
    },
    {
      "start": 814.74,
      "end": 815.78,
      "speaker": "student",
      "text": "तैंवराग ने",
      "is_question": false
    },
    {
      "start": 815.78,
      "end": 897.62,
      "speaker": "teacher",
      "text": "अगर तो बगाँ नाई ताए की हम आप दवाग नहीं तुब आम दोच्छाः ने तब क्याद़ तेखाजा है तीखे चुल तर दाव में दुक्चान है, तिबटोस के पास मम्मी नगी आया, देशा मे बास पोईटी लेई काछ़ाउ, अक तक आक बलाच न अंगे अम क्ष़",
      "is_question": true
    },
    {
      "start": 897.62,
      "end": 901.82,
      "speaker": "teacher",
      "text": "उस्वूँ अज़्े लेग तेखे तरेप वुप्र बैद्टी शोग़िजा सकते हो",
      "is_question": false
    },
    {
      "start": 901.82,
      "end": 904.12,
      "speaker": "student",
      "text": "अह वो भी होँ",
      "is_question": false
    },
    {
      "start": 904.12,
      "end": 905.72,
      "speaker": "student",
      "text": "बहुत साडे दरिका हो सक्तें",
      "is_question": false
    },
    {
      "start": 905.72,
      "end": 908.12,
      "speaker": "student",
      "text": "लिकि सब से आफान तब यह क्या हूका",
      "is_question": false
    },
    {
      "start": 908.12,
      "end": 911.95,
      "speaker": "teacher",
      "text": "अकर भिच में चेट हो जाए तो दूत जआए काना",
      "is_question": false
    },
    {
      "start": 911.95,
      "end": 921.28,
      "speaker": "teacher",
      "text": "चोटा साहे पूल बनाने कि लیکिं",
      "is_question": false
    },
    {
      "start": 921.28,
      "end": 926.08,
      "speaker": "teacher",
      "text": "गाँ में ब्रीज बनाने के लिए वो कहार रहे का?",
      "is_question": true
    },
    {
      "start": 926.08,
      "end": 934.68,
      "speaker": "teacher",
      "text": "कोंक्रिट चाही ए, सिमेटच च़ाए, इतने बड़़ बराल लोग च़्ी अगे ना?",
      "is_question": true
    },
    {
      "start": 934.68,
      "end": 937.82,
      "speaker": "teacher",
      "text": "बीच मनाते भी देखे हो का.",
      "is_question": false
    },
    {
      "start": 937.82,
      "end": 938.82,
      "speaker": "student",
      "text": "कह द़े किव बुद?",
      "is_question": false
    },
    {
      "start": 938.82,
      "end": 942.2,
      "speaker": "teacher",
      "text": "बिज कहदे था?",
      "is_question": true
    },
    {
      "start": 942.2,
      "end": 960.07,
      "speaker": "teacher",
      "text": "सहर मे दिखा हा बताओ.",
      "is_question": true
    },
    {
      "start": 960.07,
      "end": 962.07,
      "speaker": "student",
      "text": "आचे खिल गेग़ो.",
      "is_question": false
    },
    {
      "start": 962.07,
      "end": 964.07,
      "speaker": "student",
      "text": "तो आज़ ब्रीज भीच भ़ना खाओगे ना?",
      "is_question": false
    },
    {
      "start": 964.07,
      "end": 970.05,
      "speaker": "teacher",
      "text": "येस यह यीस भोर तेमबला बनोते आ जुन आक्चा",
      "is_question": false
    },
    {
      "start": 970.05,
      "end": 974.82,
      "speaker": "teacher",
      "text": "पोर्टेमा भे है आर ब़ीट याग तम चोड़़ा हैं आ क्छा औच़ क्या योच्ठा",
      "is_question": true
    },
    {
      "start": 974.82,
      "end": 979.59,
      "speaker": "teacher",
      "text": "तीक आंगट्गर भाँ बीघ यैग है क्रिज किस तुबबन बंते हां",
      "is_question": false
    },
    {
      "start": 979.59,
      "end": 984.28,
      "speaker": "teacher",
      "text": "अगर ब्रीज की उब़बते है?",
      "is_question": true
    },
    {
      "start": 984.28,
      "end": 989.33,
      "speaker": "teacher",
      "text": "या तो तिर नीख पुच्च खलाओ नजी चील",
      "is_question": false
    },
    {
      "start": 989.33,
      "end": 991.33,
      "speaker": "student",
      "text": "उस भी पानी का सोचचा गए",
      "is_question": false
    },
    {
      "start": 991.33,
      "end": 993.33,
      "speaker": "student",
      "text": "उतके उमपनी बरीक बड़े हए ना",
      "is_question": false
    },
    {
      "start": 993.33,
      "end": 995.33,
      "speaker": "student",
      "text": "ताकि ब बिरी ज कि उंब डब",
      "is_question": false
    },
    {
      "start": 995.33,
      "end": 997.33,
      "speaker": "student",
      "text": "तकिए सपाद लो उन्प़ाए",
      "is_question": false
    },
    {
      "start": 997.33,
      "end": 999.33,
      "speaker": "student",
      "text": "आवसानि से चली छाई",
      "is_question": false
    },
    {
      "start": 999.33,
      "end": 1002.33,
      "speaker": "teacher",
      "text": "और ख़ोग मज्वूद बन परतारें।",
      "is_question": false
    },
    {
      "start": 1002.33,
      "end": 1007.57,
      "speaker": "teacher",
      "text": "खोख मच्दूत आप योड गीरना चाए।",
      "is_question": false
    },
    {
      "start": 1007.57,
      "end": 1014.86,
      "speaker": "teacher",
      "text": "वीना हो रामूल बबननापडेगा।",
      "is_question": false
    },
    {
      "start": 1014.86,
      "end": 1020.08,
      "speaker": "teacher",
      "text": "सब एके विना मों लग्या हूक लेँना",
      "is_question": false
    },
    {
      "start": 1020.08,
      "end": 1023.08,
      "speaker": "teacher",
      "text": "औल ल्ड़के होचे रमुल।",
      "is_question": false
    },
    {
      "start": 1023.08,
      "end": 1032.54,
      "speaker": "teacher",
      "text": "तीके। औड क्यआ ब बाँगे॥",
      "is_question": false
    },
    {
      "start": 1032.54,
      "end": 1087.4,
      "speaker": "teacher",
      "text": "ब्रीज बदाने के लिए बूँँ बाँना है बिज को क्या बना आँ? बंजबुद ब बरनाई कि नहीं तुक अप चीचे देके ने प्रिच मज्बचुत बहनेकि ले रही नी.",
      "is_question": true
    },
    {
      "start": 1087.4,
      "end": 1106.12,
      "speaker": "teacher",
      "text": "अप पटकन लग़ ब़़ारे थे अंपना ब्रुट बनारगे लिए अर्गुक बे क्या हो का लेड़का अ ल्ट्चा तो लोग बागा प्रट़े न पाद्दे बिदिशन न कर लाँद बरूँ पर पहले रदा रहा है तुर्रे कि लुम्पदद कर कर सब लक्डिषन रेद.",
      "is_question": true
    },
    {
      "start": 1106.12,
      "end": 1110.12,
      "speaker": "teacher",
      "text": "अगर बद्यागा लग्री लेज बनावें",
      "is_question": false
    },
    {
      "start": 1110.12,
      "end": 1116.8,
      "speaker": "teacher",
      "text": "अंप्रट्कन एक गुब बलाडेगें",
      "is_question": false
    },
    {
      "start": 1116.8,
      "end": 1123.69,
      "speaker": "teacher",
      "text": "अक आपना पनगूँँ ब्लानेदे",
      "is_question": false
    },
    {
      "start": 1123.69,
      "end": 1137.05,
      "speaker": "teacher",
      "text": "अरी हल गोगग, लरका अ लिज के ही काम करोटेझ",
      "is_question": false
    },
    {
      "start": 1137.05,
      "end": 1169.71,
      "speaker": "teacher",
      "text": "अमको सार्पिल बंदा नहीं",
      "is_question": false
    },
    {
      "start": 1169.71,
      "end": 1171.71,
      "speaker": "student",
      "text": "अह अना के बैट लाए थे",
      "is_question": false
    },
    {
      "start": 1171.71,
      "end": 1174.25,
      "speaker": "teacher",
      "text": "मैंगि अतर भेटते है ना",
      "is_question": false
    },
    {
      "start": 1174.25,
      "end": 1178.38,
      "speaker": "teacher",
      "text": "अपना के पैट्टा है तिकें वेंगा अंधर बेटते हैं बच्चें",
      "is_question": false
    },
    {
      "start": 1178.38,
      "end": 1180.38,
      "speaker": "student",
      "text": "तो वम को सार्खी पनदा सो लगे",
      "is_question": false
    },
    {
      "start": 1180.38,
      "end": 1182.8,
      "speaker": "student",
      "text": "अ ब आचो उचाँ",
      "is_question": false
    },
    {
      "start": 1182.8,
      "end": 1197.31,
      "speaker": "teacher",
      "text": "उतर च्लियों",
      "is_question": false
    },
    {
      "start": 1197.31,
      "end": 1199.72,
      "speaker": "student",
      "text": "इची से अम जो नोजा",
      "is_question": false
    },
    {
      "start": 1199.72,
      "end": 1201.98,
      "speaker": "student",
      "text": "बरच़ो",
      "is_question": false
    },
    {
      "start": 1201.98,
      "end": 1203.98,
      "speaker": "student",
      "text": "कैच पिना नाच?",
      "is_question": false
    },
    {
      "start": 1203.98,
      "end": 1208.35,
      "speaker": "teacher",
      "text": "इंबर्तूर जैं",
      "is_question": false
    },
    {
      "start": 1208.35,
      "end": 1218.03,
      "speaker": "teacher",
      "text": "बनाना हाप उके",
      "is_question": false
    },
    {
      "start": 1218.03,
      "end": 1220.16,
      "speaker": "student",
      "text": "अर्के",
      "is_question": false
    },
    {
      "start": 1220.16,
      "end": 1222.64,
      "speaker": "student",
      "text": "अपी आप भूँँ आयाव अस्वाँ",
      "is_question": false
    },
    {
      "start": 1222.64,
      "end": 1240.96,
      "speaker": "teacher",
      "text": "अत्बादूर बनाना आना",
      "is_question": false
    },
    {
      "start": 1240.96,
      "end": 1248.94,
      "speaker": "teacher",
      "text": "अक अर्दोर भनाशाग",
      "is_question": false
    },
    {
      "start": 1248.94,
      "end": 1280.19,
      "speaker": "teacher",
      "text": "अम आस्सापा बद्टू बान आता",
      "is_question": false
    },
    {
      "start": 1280.19,
      "end": 1287.66,
      "speaker": "teacher",
      "text": "अना कि अंप्चाए ब्ड़ाब आम प्रद आर्स्माज़",
      "is_question": false
    },
    {
      "start": 1287.66,
      "end": 1290.68,
      "speaker": "teacher",
      "text": "अहाच बत्राई आंगा",
      "is_question": false
    },
    {
      "start": 1290.68,
      "end": 1293.36,
      "speaker": "teacher",
      "text": "अ आक आ आ स्फाट बरडूत",
      "is_question": false
    },
    {
      "start": 1293.36,
      "end": 1315.22,
      "speaker": "teacher",
      "text": "तो बड़ाना तीके न आपी आम आ जाँ जो जे आाजा।",
      "is_question": false
    }
  ],
